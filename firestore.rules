rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all (Master Gate)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUserDashboard(data) {
      return data.userId is string &&
             data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.config is map &&
             data.updatedAt is string &&
             data.updatedAt.size() <= 64;
    }

    // Initial connection test probe
    match /test/connection {
      allow read: if true;
    }

    // User dashboard private documents
    match /users/{userId}/dashboard/data {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserDashboard(incoming());
      allow update: if isValidId(userId) && isOwner(userId) && isValidUserDashboard(incoming()) && incoming().userId == resource.data.userId;
      allow delete: if isValidId(userId) && isOwner(userId);
    }
  }
}
